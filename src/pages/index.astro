---
const heroPhrases = [
  'Ali is a passionate AI engineer',
  'Ali bridges the gap between design and LLM UX',
  'Ali lives in Lahore, Pakistan',
  'Ali obsesses over UX, performance, and detail',
  'Ali is a hybrid builder and design thinker',
  'Ali builds polished, accessible interfaces',
  'Ali prototypes directly in the browser',
  'Ali ships conversational products with care',
  'Ali turns rough ideas into refined experiences',
  'Ali can make your chatbot feel premium',
  'Ali writes clean code and sharp copy',
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ali | Chatbot</title>
  <meta
    name="description"
    content="Ali is a Lahore-based AI engineer. Chat live in a polished interface inspired by top design portfolios."
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500;700&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    :root,
    :host {
      --font-sans: Inter, 'Plus Jakarta Sans', system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      --font-mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;

      --color-black: #000000e6;
      --color-white: #fff;

      --accent-speed: 5s;
      --accent-dot-lag: 120ms;
      --color-foreground: #efebd4;
      --color-red: #e67e80;
      --color-orange: #e69875;
      --color-yellow: #dbbc7f;
      --color-green: #a7c080;
      --color-blue: #7fbbb3;
      --color-aqua: #83c092;
      --color-purple: #d699b6;

      --color-background-dim: #232a2e;
      --color-background-0: #2d353b;
      --color-background-1: #343f44;
      --color-background-2: #3d484d;
      --color-gray-0: #7a8478;

      --color-accent: transparent;
      --color-fg-on-accent: var(--color-background-1);
      --color-fg-on-accent-most-contrast: var(--color-black);

      --chat-surface: color-mix(in oklab, var(--color-background-dim) 80%, var(--color-black) 20%);
      --chat-surface-soft: color-mix(in oklab, var(--color-background-dim) 68%, var(--color-black) 32%);
      --chat-border: color-mix(in oklab, var(--color-background-dim) 56%, var(--color-black) 44%);
      --chat-muted: color-mix(in oklab, var(--color-foreground) 62%, transparent);

      --text-xs: clamp(0.625rem, 0.282vw + 0.559rem, 0.813rem);
      --text-base: clamp(1rem, 0.188vw + 0.956rem, 1.125rem);
      --text-lg: clamp(1.125rem, 0.563vw + 0.993rem, 1.5rem);
      --text-xl: clamp(1.25rem, 1.502vw + 0.898rem, 2.25rem);
      --text-2xl: clamp(1.5rem, 2.254vw + 0.972rem, 3rem);
      --text-3xl: clamp(2.125rem, 5.822vw + 0.761rem, 6rem);
      --text-4xl: clamp(2.5rem, 5.258vw + 1.268rem, 6rem);

      --spacing-3xs: clamp(0.25rem, 0.228rem + 0.0939vw, 0.3125rem);
      --spacing-2xs: clamp(0.4375rem, 0.3935rem + 0.1878vw, 0.5625rem);
      --spacing-xs: clamp(0.6875rem, 0.6215rem + 0.2817vw, 0.875rem);
      --spacing-sm: clamp(0.875rem, 0.787rem + 0.3756vw, 1.125rem);
      --spacing-md: clamp(1.25rem, 1.125rem + 0.5vw, 1.5rem);
      --spacing-lg: clamp(1.75rem, 1.5739rem + 0.7512vw, 2.25rem);
      --spacing-xl: clamp(2.625rem, 2.3609rem + 1.1268vw, 3.375rem);
      --spacing-2xl: clamp(3.5rem, 3.1479rem + 1.5023vw, 4.5rem);
      --spacing-3xl: clamp(5.25rem, 4.7218rem + 2.2535vw, 6.75rem);

      --radius-sm: 0.25rem;
      --radius-lg: 0.5rem;
      --radius-xl: 0.75rem;
    }

    [data-theme='light'] {
      --color-foreground: #232a2e;
      --color-red: #dd4c49;
      --color-orange: #c4641e;
      --color-yellow: #a57600;
      --color-green: #768601;
      --color-blue: #3486b2;
      --color-aqua: #2d8e6a;
      --color-purple: #bf5aa0;
      --color-background-dim: #efebd4;
      --color-background-0: #fdf6e3;
      --color-background-1: #f4f0d9;
      --color-background-2: #efebd4;
      --color-gray-0: #a6b0a0;
      --color-fg-on-accent-most-contrast: var(--color-white);
      --color-fg-on-accent: var(--color-background-1);

      --chat-surface: color-mix(in oklab, var(--color-background-0) 92%, var(--color-black) 8%);
      --chat-surface-soft: color-mix(in oklab, var(--color-background-0) 84%, var(--color-black) 16%);
      --chat-border: color-mix(in oklab, var(--color-background-0) 58%, var(--color-black) 42%);
      --chat-muted: color-mix(in oklab, var(--color-foreground) 55%, transparent);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 100%;
      min-height: 100%;
    }

    body {
      font-family: var(--font-sans);
      color: var(--color-foreground);
      background: var(--color-background-dim);
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body::before {
      content: '';
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: -1;
      background: radial-gradient(120% 100% at 50% 25%, var(--color-background-1) 0%, var(--color-background-dim) 60%);
      opacity: 0.28;
    }

    .text-accent {
      color: var(--color-accent);
      transition: color var(--accent-speed) linear;
    }

    .bg-accent {
      background-color: var(--color-accent);
      transition: background-color var(--accent-speed) linear;
    }

    .theme-switching .text-accent,
    .theme-switching .bg-accent {
      transition: color linear, background-color linear;
    }

    .inner {
      width: 85%;
      max-width: 1440px;
      margin: 0 auto;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .type-eyebrow {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.035em;
      text-transform: uppercase;
      font-weight: 500;
    }

    .type-caption {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: -0.01em;
      font-weight: 400;
    }

    .type-2xl {
      font-size: var(--text-2xl);
      letter-spacing: -0.035em;
      font-weight: 500;
      line-height: 1.1;
    }

    .type-4xl {
      font-size: var(--text-4xl);
      letter-spacing: -0.035em;
      font-weight: 500;
      line-height: 1;
    }

    .type-base {
      font-size: var(--text-base);
      line-height: 1.4;
      font-weight: 400;
    }

    .site-header {
      padding-top: var(--spacing-xl);
      padding-bottom: var(--spacing-3xl);
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 10;
    }

    .header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      color: var(--color-foreground);
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .logo:hover,
    .logo:focus-visible {
      color: var(--color-accent);
    }

    .theme-switcher {
      display: flex;
      align-items: center;
      gap: var(--spacing-3xs);
      padding: var(--spacing-3xs);
      border-radius: var(--radius-xl);
      background: var(--color-background-0);
      color: var(--color-foreground);
    }

    .theme-switcher button {
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      border-radius: var(--radius-lg);
      padding: var(--spacing-3xs);
      opacity: 0.72;
      transition: color 0.3s ease, transform 0.2s ease;
    }

    .theme-switcher button:hover,
    .theme-switcher button:focus-visible {
      color: var(--color-accent);
      outline: none;
      transform: translateY(-1px);
    }

    [data-theme='dark'] [data-theme-switcher='dark'],
    [data-theme='light'] [data-theme-switcher='light'] {
      background-color: var(--color-background-2);
      pointer-events: none;
      opacity: 1;
      cursor: default;
    }

    .theme-switcher svg {
      width: 18px;
      height: 18px;
      display: block;
    }

    .hero-fixed {
      position: fixed;
      inset: 0;
      min-height: 600px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-wrap {
      min-height: 300px;
      display: block;
      margin-top: var(--spacing-lg);
      max-width: 1120px;
    }

    .js-typer {
      display: inline;
    }

    .js-typer::after {
      content: '_';
      display: inline-block;
      animation: blink 1s step-end infinite;
      margin-left: 0.04em;
      transform: translateY(-0.02em);
    }

    @keyframes blink {
      0%,
      45% { opacity: 1; }
      50%,
      100% { opacity: 0; }
    }

    .project-container {
      position: relative;
      z-index: 10;
      margin-top: calc(100dvh - 84px);
      transform: translateY(84px);
      transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .initial-load {
      width: 100%;
      height: 100%;
      position: fixed;
      inset: 0;
      overflow: scroll;
    }

    .has-typed {
      position: relative;
      overflow: auto;
    }

    .has-typed .project-container {
      transform: translateY(0);
    }

    .chat-strip {
      border-top: 1px solid color-mix(in oklab, var(--color-background-dim) 20%, transparent);
      border-bottom: 1px solid color-mix(in oklab, var(--color-background-dim) 20%, transparent);
      color: var(--color-fg-on-accent);
    }

    .anchor {
      display: block;
      text-decoration: none;
      padding-block: var(--spacing-lg);
      color: inherit;
      transition: color 0.3s ease;
    }

    .anchor:hover,
    .anchor:focus-visible {
      color: var(--color-fg-on-accent-most-contrast);
      outline: none;
    }

    .chat-panel {
      color: var(--color-fg-on-accent);
      padding-bottom: var(--spacing-3xl);
    }

    .chat-intro {
      padding-top: var(--spacing-lg);
      padding-bottom: var(--spacing-xl);
      max-width: 90%;
      text-wrap: pretty;
    }

    .chat-frame {
      background: linear-gradient(180deg, var(--chat-surface) 0%, var(--chat-surface-soft) 100%);
      border: 1px solid var(--chat-border);
      border-radius: calc(var(--radius-xl) + 0.2rem);
      overflow: hidden;
      box-shadow:
        0 18px 40px color-mix(in oklab, var(--color-black) 22%, transparent),
        inset 0 1px 0 color-mix(in oklab, var(--color-white) 8%, transparent);
      color: var(--color-foreground);
    }

    .chat-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--spacing-sm);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-bottom: 1px solid color-mix(in oklab, var(--chat-border) 70%, transparent);
      background: color-mix(in oklab, var(--chat-surface-soft) 82%, transparent);
    }

    .chat-meta-left {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      min-width: 0;
    }

    .chat-live-dot {
      width: 0.5rem;
      height: 0.5rem;
      border-radius: 999px;
      background-color: var(--color-accent);
      box-shadow: 0 0 0.45rem color-mix(in oklab, var(--color-accent) 65%, transparent);
      flex: none;
      transition:
        background-color var(--accent-speed) linear var(--accent-dot-lag),
        box-shadow var(--accent-speed) linear var(--accent-dot-lag);
    }

    .chat-live-text {
      color: var(--chat-muted);
    }

    .chat-meta-right {
      color: var(--chat-muted);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.03em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .chat-messages-wrap {
      position: relative;
      background: color-mix(in oklab, var(--chat-surface) 92%, transparent);
    }

    .chat-messages {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      min-height: 17rem;
      max-height: min(56rem, 68vh);
      overflow-y: auto;
      padding: var(--spacing-sm);
      padding-right: calc(var(--spacing-sm) + 0.72rem);
      background: transparent;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .chat-messages::-webkit-scrollbar {
      width: 0;
      height: 0;
      display: none;
    }

    .chat-scrollbar {
      position: absolute;
      top: var(--spacing-sm);
      right: calc(var(--spacing-xs) * 0.5);
      bottom: var(--spacing-sm);
      width: 0.46rem;
      border-radius: 999px;
      background-color: color-mix(in oklab, var(--chat-surface) 84%, transparent);
      pointer-events: none;
      opacity: 0.92;
      transition:
        background-color var(--accent-speed) linear,
        opacity 0.2s ease;
    }

    .chat-scrollbar-thumb {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2rem;
      border-radius: 999px;
      background-color: var(--color-accent);
      border: 1px solid color-mix(in oklab, var(--chat-surface) 78%, transparent);
      box-shadow: 0 0 0.4rem color-mix(in oklab, var(--color-accent) 28%, transparent);
      transform: translateY(0);
      will-change: transform;
      transition:
        background-color var(--accent-speed) linear,
        border-color var(--accent-speed) linear,
        box-shadow var(--accent-speed) linear;
    }

    .chat-scrollbar.is-hidden {
      opacity: 0;
    }

    .msg-row {
      display: flex;
      width: 100%;
    }

    .msg-row.user {
      justify-content: flex-end;
    }

    .msg-row.assistant {
      justify-content: flex-start;
    }

    .msg {
      width: fit-content;
      min-width: 0;
      max-width: min(30rem, 70%);
      padding: 0.48rem 0.72rem 0.56rem;
      border-radius: 0.95rem;
      margin: 0;
      line-height: 1.35;
      font-size: 0.92rem;
      white-space: pre-wrap;
      word-break: break-word;
      box-shadow: 0 3px 10px color-mix(in oklab, var(--color-black) 9%, transparent);
    }

    .msg.user {
      background-color: var(--color-accent);
      border: 1px solid color-mix(in oklab, var(--chat-border) 45%, transparent);
      color: var(--color-fg-on-accent-most-contrast);
      border-bottom-right-radius: 0.25rem;
      transition:
        background-color var(--accent-speed) linear,
        border-color var(--accent-speed) linear,
        color 0.3s ease;
    }
    
    .msg.user .msg-label {
      text-align: right;
      color: color-mix(in oklab, var(--color-fg-on-accent-most-contrast) 70%, transparent);
      transition: color var(--accent-speed) linear;
    }

    .msg.assistant {
      background: color-mix(in oklab, var(--chat-surface-soft) 52%, var(--color-background-1));
      border: 1px solid color-mix(in oklab, var(--chat-border) 60%, transparent);
      color: var(--color-foreground);
      border-bottom-left-radius: 0.25rem;
    }

    .msg-label {
      display: block;
      margin-bottom: 0.1rem;
      font-family: var(--font-mono);
      font-size: 0.58rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: 0.65;
    }

    .msg-body {
      display: block;
      font-size: clamp(0.86rem, 0.16vw + 0.83rem, 0.95rem);
      line-height: 1.34;
    }

    .msg.pending {
      border: 1px dashed color-mix(in oklab, var(--chat-border) 75%, transparent);
      box-shadow: none;
      opacity: 0.78;
      font-style: italic;
    }

    .chat-form {
      display: flex;
      align-items: center;
      gap: var(--spacing-xs);
      padding: var(--spacing-xs) var(--spacing-sm);
      border-top: 1px solid color-mix(in oklab, var(--chat-border) 70%, transparent);
      background: color-mix(in oklab, var(--chat-surface-soft) 86%, transparent);
    }

    .chat-input {
      flex: 1;
      border: 0;
      outline: 0;
      border: 1px solid color-mix(in oklab, var(--color-accent) 72%, var(--chat-border));
      padding: var(--spacing-xs) var(--spacing-sm);
      border-radius: 999px;
      background: color-mix(in oklab, var(--chat-surface) 72%, transparent);
      color: var(--color-foreground);
      font-family: var(--font-sans);
      font-size: clamp(0.9rem, 0.12vw + 0.87rem, 0.96rem);
      transition:
        border-color var(--accent-speed) linear var(--accent-dot-lag),
        box-shadow 0.2s ease,
        background-color 0.2s ease;
    }

    .chat-input:focus {
      background: color-mix(in oklab, var(--chat-surface) 64%, transparent);
      box-shadow: 0 0 0 2px color-mix(in oklab, var(--color-accent) 25%, transparent);
    }

    .chat-input::placeholder {
      color: var(--chat-muted);
    }

    .chat-send {
      border: 0;
      border-radius: 999px;
      min-width: 5rem;
      padding: var(--spacing-xs) var(--spacing-sm);
      background-color: var(--color-accent);
      color: var(--color-fg-on-accent-most-contrast);
      font-family: var(--font-mono);
      font-size: clamp(0.62rem, 0.2vw + 0.58rem, 0.7rem);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      border: 1px solid color-mix(in oklab, var(--chat-border) 55%, transparent);
      transition:
        background-color var(--accent-speed) linear,
        border-color var(--accent-speed) linear,
        color 0.3s ease,
        transform 0.2s ease,
        opacity 0.2s ease,
        filter 0.2s ease;
    }

    .chat-send:hover,
    .chat-send:focus-visible {
      transform: translateY(-1px);
      opacity: 0.9;
      filter: saturate(1.15);
      outline: none;
    }

    .chat-send:disabled {
      opacity: 0.58;
      transform: none;
      filter: none;
      cursor: not-allowed;
    }

    .chat-input:disabled {
      opacity: 0.72;
      cursor: not-allowed;
    }

    .site-footer {
      border-top: 1px solid color-mix(in oklab, var(--color-background-dim) 20%, transparent);
      color: var(--color-fg-on-accent);
    }

    .footer-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
      padding-block: var(--spacing-lg);
    }

    .footer-updated {
      display: inline-flex;
      align-items: center;
      gap: 0.45ch;
      line-height: 1;
    }

    .footer-marker {
      font-size: 1.35em;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      transform: translateY(-0.02em);
    }

    @media (max-width: 768px) {
      .inner {
        width: 90%;
      }

      .hero-wrap {
        min-height: 220px;
      }

      .chat-intro {
        max-width: 100%;
      }

      .msg {
        max-width: 88%;
      }

      .chat-messages {
        padding: var(--spacing-sm) var(--spacing-xs);
        padding-right: calc(var(--spacing-xs) + 0.72rem);
        gap: var(--spacing-xs);
        max-height: min(40rem, 62vh);
      }

      .chat-scrollbar {
        right: 0.2rem;
        width: 0.4rem;
      }

      .chat-form {
        padding-inline: var(--spacing-sm);
        gap: var(--spacing-xs);
      }

      .chat-meta {
        padding-inline: var(--spacing-sm);
      }

      .chat-send {
        min-width: 4.8rem;
        padding-inline: var(--spacing-sm);
      }
    }
  </style>
</head>

<body class="bg-background-dim theme-switching initial-load" data-theme="dark">
  <header class="site-header">
    <div class="inner header-row">
      <a class="type-eyebrow logo" href="/">Ali</a>

      <div class="theme-switcher" aria-label="Theme switcher">
        <button aria-label="Toggle light mode" aria-pressed="false" data-theme-switcher="light" type="button">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM11 1H13V4H11V1ZM11 20H13V23H11V20ZM3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364ZM19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497ZM23 11V13H20V11H23ZM4 11V13H1V11H4Z" fill="currentColor"></path>
          </svg>
        </button>

        <button aria-label="Toggle dark mode" aria-pressed="false" data-theme-switcher="dark" type="button">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M10 7C10 10.866 13.134 14 17 14C18.9584 14 20.729 13.1957 21.9995 11.8995C22 11.933 22 11.9665 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C12.0335 2 12.067 2 12.1005 2.00049C10.8043 3.27098 10 5.04157 10 7ZM4 12C4 16.4183 7.58172 20 12 20C15.0583 20 17.7158 18.2839 19.062 15.7621C18.3945 15.9187 17.7035 16 17 16C12.0294 16 8 11.9706 8 7C8 6.29648 8.08133 5.60547 8.2379 4.938C5.71611 6.28423 4 8.9417 4 12Z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    <div class="hero-fixed">
      <div class="inner">
        <h1 class="sr-only">Ali is an AI engineer based in Lahore.</h1>
        <div class="type-4xl text-accent hero-wrap">
          <span class="js-typer"></span>
        </div>
      </div>
    </div>

    <div class="project-container">
      <section class="chat-strip bg-accent">
        <div class="inner">
          <h2 class="type-eyebrow">
            <a href="#chat" class="anchor js-scroll-chat">Chat</a>
          </h2>
        </div>
      </section>

      <section id="chat" class="chat-panel bg-accent">
        <div class="inner">
          <h3 class="type-2xl chat-intro">Ask anything.</h3>

          <div class="chat-frame">
            <div class="chat-meta">
              <div class="chat-meta-left">
                <span class="chat-live-dot" aria-hidden="true"></span>
                <p class="chat-live-text type-caption">Ali is online</p>
              </div>
              <p class="chat-meta-right">Real-time</p>
            </div>

            <div class="chat-messages-wrap">
              <div id="chat-messages" class="chat-messages" aria-live="polite"></div>
              <div id="chat-scrollbar" class="chat-scrollbar" aria-hidden="true">
                <span id="chat-scrollbar-thumb" class="chat-scrollbar-thumb"></span>
              </div>
            </div>

            <form id="chat-form" class="chat-form">
              <input
                id="chat-input"
                class="chat-input"
                type="text"
                autocomplete="off"
                placeholder="Message Ali..."
              />
              <button id="chat-send" class="chat-send" type="submit">Send</button>
            </form>
          </div>
        </div>
      </section>

      <footer class="site-footer bg-accent">
        <div class="inner footer-row type-caption">
          <p class="footer-updated"><span class="footer-marker" aria-hidden="true">&#x262E;</span><span>Updated Mar 2026</span></p>
          <p>Built by Muhammad Ali with Astro, Groq, and care.</p>
        </div>
      </footer>
    </div>
  </main>

  <script is:inline define:vars={{ heroPhrases }}>
    (function () {
      'use strict';

      var THEME_STORAGE_KEY = 'theme';
      var DEFAULT_THEME = 'dark';

      function setTheme(theme) {
        document.body.setAttribute('data-theme', theme);
      }

      function saveTheme(theme) {
        try {
          localStorage.setItem(THEME_STORAGE_KEY, theme);
        } catch (e) {
          // Ignore storage failures.
        }
      }

      function getSavedTheme() {
        try {
          var saved = localStorage.getItem(THEME_STORAGE_KEY);
          if (saved === 'light' || saved === 'dark') {
            return saved;
          }
        } catch (e) {
          // Ignore storage failures.
        }

        return DEFAULT_THEME;
      }

      function applyTheme(theme) {
        var body = document.body;
        body.classList.add('theme-switching');
        setTheme(theme);
        syncThemeSwitcherState(theme);
        saveTheme(theme);
        requestAnimationFrame(function () {
          requestAnimationFrame(function () {
            body.classList.remove('theme-switching');
          });
        });
      }

      function syncThemeSwitcherState(theme) {
        document.querySelectorAll('[data-theme-switcher]').forEach(function (button) {
          var isActive = button.getAttribute('data-theme-switcher') === theme;
          button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      }

      var bootTheme = getSavedTheme();
      setTheme(bootTheme);
      syncThemeSwitcherState(bootTheme);

      function initThemeSwitcher() {
        document.querySelectorAll('[data-theme-switcher]').forEach(function (button) {
          button.addEventListener('click', function () {
            var theme = button.getAttribute('data-theme-switcher');
            if (theme === 'light' || theme === 'dark') {
              applyTheme(theme);
            }
          });
        });
      }

      function smoothScrollTo(targetY, duration) {
        var startY = window.scrollY;
        var distance = targetY - startY;
        var startTime = null;

        function easeInOutCubic(t) {
          return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        }

        function frame(timestamp) {
          if (startTime === null) {
            startTime = timestamp;
          }

          var elapsed = timestamp - startTime;
          var progress = Math.min(elapsed / duration, 1);
          var eased = easeInOutCubic(progress);

          window.scrollTo(0, startY + distance * eased);

          if (progress < 1) {
            requestAnimationFrame(frame);
          }
        }

        requestAnimationFrame(frame);
      }

      function initChatScroll() {
        document.querySelectorAll('.js-scroll-chat[href^="#"]').forEach(function (link) {
          link.addEventListener('click', function (event) {
            var targetId = link.getAttribute('href');
            if (!targetId) return;

            var target = document.querySelector(targetId);
            if (!target) return;

            event.preventDefault();

            // Ensure the lower panel is in its fully visible state before scrolling.
            document.body.classList.add('has-typed');

            var top = window.scrollY + target.getBoundingClientRect().top - 8;
            var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (reduceMotion) {
              window.scrollTo(0, top);
            } else {
              smoothScrollTo(top, 800);
            }

            if (history.replaceState) {
              history.replaceState(null, '', targetId);
            }
          });
        });
      }

      var accentColors = [
        'var(--color-red)',
        'var(--color-orange)',
        'var(--color-yellow)',
        'var(--color-green)',
        'var(--color-blue)',
        'var(--color-aqua)',
        'var(--color-purple)',
      ];

      var accentIndex = Math.floor(Math.random() * accentColors.length);
      var ascend = Math.random() >= 0.5;

      function rotateAccent() {
        if (ascend) {
          if (accentIndex < accentColors.length - 1) {
            accentIndex += 1;
          } else {
            ascend = false;
            accentIndex -= 1;
          }
        } else if (accentIndex > 0) {
          accentIndex -= 1;
        } else {
          ascend = true;
          accentIndex += 1;
        }

        document.body.style.setProperty('--color-accent', accentColors[accentIndex]);
      }

      function shuffle(array) {
        var clone = array.slice();
        for (var i = clone.length - 1; i > 0; i -= 1) {
          var j = Math.floor(Math.random() * (i + 1));
          var temp = clone[i];
          clone[i] = clone[j];
          clone[j] = temp;
        }
        return clone;
      }

      function initTyper() {
        var typerEl = document.querySelector('.js-typer');
        if (!typerEl) return;

        var first = heroPhrases[0];
        var rest = heroPhrases.slice(1);
        var ordered = [first].concat(shuffle(rest));

        var phraseIndex = 0;
        var charIndex = 0;
        var deleting = false;

        function tick() {
          var phrase = ordered[phraseIndex];

          if (!deleting) {
            charIndex += 1;
            typerEl.textContent = phrase.slice(0, charIndex);

            if (charIndex >= phrase.length) {
              if (phraseIndex === 0) {
                document.body.classList.add('has-typed');
              }

              deleting = true;
              setTimeout(tick, 3000);
              return;
            }

            setTimeout(tick, 25);
            return;
          }

          charIndex -= 1;
          typerEl.textContent = phrase.slice(0, Math.max(0, charIndex));

          if (charIndex <= 0) {
            deleting = false;
            phraseIndex = (phraseIndex + 1) % ordered.length;
            setTimeout(tick, 250);
            return;
          }

          setTimeout(tick, 15);
        }

        tick();
      }

      function initChat() {
        var form = document.getElementById('chat-form');
        var input = document.getElementById('chat-input');
        var list = document.getElementById('chat-messages');
        var send = document.getElementById('chat-send');
        var scrollbar = document.getElementById('chat-scrollbar');
        var scrollbarThumb = document.getElementById('chat-scrollbar-thumb');
        if (!form || !input || !list || !send || !scrollbar || !scrollbarThumb) return;

        var history = [];
        var pending = null;

        function escapeHtml(text) {
          var div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }

        function syncScrollbar() {
          var maxScroll = list.scrollHeight - list.clientHeight;

          if (maxScroll <= 0) {
            scrollbar.classList.add('is-hidden');
            scrollbarThumb.style.height = '0px';
            scrollbarThumb.style.transform = 'translateY(0px)';
            return;
          }

          scrollbar.classList.remove('is-hidden');

          var trackHeight = scrollbar.clientHeight;
          var minThumbHeight = 30;
          var thumbHeight = Math.max((list.clientHeight / list.scrollHeight) * trackHeight, minThumbHeight);
          thumbHeight = Math.min(thumbHeight, trackHeight);

          var maxThumbOffset = Math.max(trackHeight - thumbHeight, 0);
          var thumbOffset = maxThumbOffset * (list.scrollTop / maxScroll);

          scrollbarThumb.style.height = thumbHeight + 'px';
          scrollbarThumb.style.transform = 'translateY(' + thumbOffset + 'px)';
        }

        function scrollToBottom() {
          list.scrollTop = list.scrollHeight;
          requestAnimationFrame(syncScrollbar);
        }

        function createMessageElement(role, content, isPending) {
          var who = role === 'user' ? 'You' : 'Ali';
          var row = document.createElement('div');
          row.className = 'msg-row ' + role;

          var bubble = document.createElement('div');
          bubble.className = 'msg ' + role + (isPending ? ' pending' : '');
          bubble.innerHTML =
            '<span class="msg-label">' +
            who +
            '</span><div class="msg-body">' +
            escapeHtml(content).replace(/\n/g, '<br>') +
            '</div>';

          row.appendChild(bubble);
          return row;
        }

        function addMessage(role, content) {
          var el = createMessageElement(role, content, false);

          list.appendChild(el);
          scrollToBottom();
        }

        function showPending() {
          pending = createMessageElement('assistant', 'Thinking...', true);
          list.appendChild(pending);
          scrollToBottom();
        }

        function clearPending() {
          if (pending) {
            pending.remove();
            pending = null;
            requestAnimationFrame(syncScrollbar);
          }
        }

        function setBusy(isBusy) {
          form.setAttribute('aria-busy', isBusy ? 'true' : 'false');
          input.disabled = isBusy;
          send.disabled = isBusy;
          send.textContent = isBusy ? 'Sending...' : 'Send';
        }

        var welcome = 'Hey. I am live. Ask me anything.';
        addMessage('assistant', welcome);
        history.push({ role: 'assistant', content: welcome });

        list.addEventListener('scroll', syncScrollbar, { passive: true });
        window.addEventListener('resize', function () {
          requestAnimationFrame(syncScrollbar);
        });
        requestAnimationFrame(syncScrollbar);

        form.addEventListener('submit', async function (event) {
          event.preventDefault();

          var value = input.value.trim();
          if (!value) return;

          addMessage('user', value);
          history.push({ role: 'user', content: value });
          input.value = '';

          showPending();
          setBusy(true);

          try {
            var response = await fetch('/api/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ messages: history }),
            });

            var data = await response.json();
            clearPending();

            if (!response.ok || !data.reply) {
              addMessage('assistant', (data && data.error) || 'Could not get a reply right now.');
              return;
            }

            var reply = String(data.reply).trim();
            addMessage('assistant', reply);
            history.push({ role: 'assistant', content: reply });
          } catch (err) {
            clearPending();
            addMessage('assistant', 'Network issue. Please try again.');
          } finally {
            setBusy(false);
            input.focus();
          }
        });
      }

      document.addEventListener('DOMContentLoaded', function () {
        initThemeSwitcher();
        initChatScroll();

        document.body.style.setProperty('--color-accent', accentColors[accentIndex]);
        setTimeout(function () {
          document.body.classList.remove('theme-switching');
        }, 100);

        setInterval(rotateAccent, 5000);
        initTyper();
        initChat();
      });
    })();
  </script>
</body>
</html>
